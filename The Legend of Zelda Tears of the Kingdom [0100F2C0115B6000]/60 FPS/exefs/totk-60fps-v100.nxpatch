# The Legend of Zelda: Tears of the Kingdom [0100F2C0115B6000] 1.0.0 - 60 FPS
# Runs the game at 60 fps at the right speed: the world, cloth and bounces step by the measured frame time instead of
# a fixed 30 fps step.
# NXEmu patch sets (nxemu-loader core/file_sys/patch_sets.h). The sets and sites are MacNativeGames
# games/totk/runtime/game_patches.c at upstream 9fe3fdc (MIT, Copyright (c) 2026 MacNativeGames contributors), whose
# 1.0.0 offsets they are. The equipment-switch fix follows totk-pc-recomp's 1.2.1 and 1.4.3 one (issue #18, found by
# JieML1100; MIT, Copyright (c) 2026 Valiantsin Dzerakh), located again in 1.0.0. 1.0.0 has no fades fix.
# The patch page holds the frame step NXEmu writes at every present: +0 the 30 Hz ratio (seconds * 30), +4 the step
# in seconds, +12 1 while a video plays. The fps60 set lets the game run at 60 fps, and at its own rate while a
# video plays; it is changed from upstream for that.

@nsobid-082CE09B06E33A123CB1E2770F5F9147709033DB
@version 1.0.0

set fps60    TOTK_FPS60          1
set realtime TOTK_REALTIME       1
set cloth    TOTK_CLOTH_REALTIME 1
set bounce   TOTK_HIGHFPS_FIX    1

# 60 fps: the adaptive present-interval controller (main+0x8f6bec) uses the minimum interval 1, except while a video
# plays (patch page +12): the game shows one frame of its 30 fps movies per game frame, so a pre-rendered cutscene plays
# at its speed only at the frame rate the game was made for. The game's minimum at +0 (2: 30 fps) is replaced where it
# is loaded, so the rest of the controller runs as the game wrote it. The flags each cave sets are set again by the
# next compare.
site fps60 main 8f6c48 29402e88 @page:x8 b9400d08 7100011f 29402e88 1a9f1508   # ldp w8, w11, [x20]: w8 = video ? minimum : 1
site fps60 main 8f6c88 b9401a8a @page:x11 b9400d6b 7100017f b9401a8b 1a8a116a   # ldr w10, [x20, #24]: the stored candidate only while a video plays, else the desired interval (w11 is free)
site fps60 main 8f6d7c b9400288 @page:x8 b9400d08 7100011f b9400288 1a9f1508   # ldr w8, [x20]: w8 = video ? minimum : 1
site fps60 main 8f6d98 2a0a03f5 1a9fa555   # lower path: csinc w21, w10, wzr, ge (result never below 1)

# Real-time step. The frame-step function (main+0x7a83e4) turns the present interval w1 into {ratio = interval * 0.5,
# seconds = interval / 60} and stores them at x0+8; both come from the patch page instead. The global ratio after the
# controller call (main+0x8f68b4) reads the ratio from the page instead of interval * 0.5.
site realtime main 7a83f4 1e220020 @page:x9   # scvtf s0, w1 -> adrp x9, page
site realtime main 7a83f8 52a84e08 bd400120   # mov w8, #60.0 -> ldr s0, [x9] (ratio)
site realtime main 7a83fc 1e270101 bd400521   # fmov s1, w8 -> ldr s1, [x9, #4] (seconds)
site realtime main 7a8400 1e2c1002 d503201f   # fmov s2, #0.5 -> nop
site realtime main 7a840c 1e211801 d503201f   # fdiv s1, s0, s1 -> nop
site realtime main 7a8410 1e220800 d503201f   # fmul s0, s0, s2 -> nop
site realtime main 8f68b8 bd425e60 @page:x9   # ldr s0, [x19, #0x25c] -> adrp x9, page
site realtime main 8f68bc 1e2c1001 bd400120   # fmov s1, #0.5 -> ldr s0, [x9] (global ratio)
site realtime main 8f68cc 5e21d800 d503201f   # scvtf s0, s0 -> nop
site realtime main 8f68d0 1e210800 d503201f   # fmul s0, s0, s1 -> nop

# Equipment-switch cooldown: the player update steps the countdown at player state +0x109c (main+0x6a9828) through
# the timer step (main+0x7e9c18, value += ratio * rate) only while it is above FLT_EPSILON, but weapon, shield and bow
# changes stay blocked while it is above 0. A measured ratio can leave a remainder in (0, FLT_EPSILON] that is never
# stepped again and keeps equipment locked until a load; stepping while above 0 takes it below 0.
site realtime main 6a9834 1e270101 1e2703e1   # fmov s1, w8 (FLT_EPSILON) -> fmov s1, wzr

# Hair and cloth: the actor animation update builds a second clock {seconds = factor / 30, ratio = factor} per
# rendered frame. 1.0.0 inlines it in three places: fmul s<r>, s<f>, s<r> (s<r> = 1/30, s<f> = the factor) gives the
# seconds, and the factor is stored to the ratio slot after it. The fmul now gives measured seconds * factor, and the
# store puts measured ratio * factor in the ratio slot. x9 and s31 are saved around their use; the sp-relative slot
# moves by the 32 bytes the save takes. The out-of-line update (main+0x82c224) is called with s2 (seconds) and s3
# (ratio), which are scaled by the measured ratio; x8 and s4 are not arguments of it and are caller-saved.
site cloth main 7b5988 1e200900 f81f0fe9 @page:x9 bd400520 1e200900 f84107e9   # fmul s0, s8, s0: s0 = [page+4] first
site cloth main 7b598c 2d3823a0 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f091f 2d387fa0 3dc007ff f94003e9 910083ff   # stp s0, s8, [x29, #-0x40] -> stp s0, s31 (s31 = [page] * s8)
site cloth main 7b6b28 1e200900 f81f0fe9 @page:x9 bd400520 1e200900 f84107e9   # the same, second actor path
site cloth main 7b6b2c 2d3823a0 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f091f 2d387fa0 3dc007ff f94003e9 910083ff
site cloth main 7f5ec4 1e210801 f81f0fe9 @page:x9 bd400521 1e210801 f84107e9   # fmul s1, s0, s1: s1 = [page+4] first
site cloth main 7f5ed0 bd0117e0 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f081f bd0137ff 3dc007ff f94003e9 910083ff   # str s0, [sp, #0x114] -> str s31 (s31 = [page] * s0)
site cloth main 7b6358 9401d7b3 @page:x8 bd400104 1e240842 1e240863 9401d7b3   # bl 0x82c224: s2, s3 *= [page]

# Trampolines: the contact code scales the bounce vector by 0.1 when time object +0x28 (30 / (ratio * time scale)) is
# over 100; compare +0x28 * +0x38 (30 / time scale) instead, the same value at 30 Hz and independent of the frame rate.
# s1 is set again by the fmov two instructions on.
site bounce main ce3fec bd402900 bd402900 bd403901 1e210800   # ldr s0, [x8, #0x28]; ldr s1, [x8, #0x38]; fmul s0, s0, s1

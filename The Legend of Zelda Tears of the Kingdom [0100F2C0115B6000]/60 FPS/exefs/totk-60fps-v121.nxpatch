# The Legend of Zelda: Tears of the Kingdom [0100F2C0115B6000] 1.2.1 - 60 FPS
# Runs the game at 60 fps at the right speed: the world, cloth, bounces, the map cursor and the vertical aim step by
# the measured frame time instead of a fixed 30 fps step.
# NXEmu patch sets (nxemu-loader core/file_sys/patch_sets.h). The sets and sites are totk-pc-recomp's
# recomp/patches-v121.txt at ae30a61 (MIT, Copyright (c) 2026 Valiantsin Dzerakh), itself ported from MacNativeGames
# games/totk/runtime/game_patches.c (MIT, Copyright (c) 2026 MacNativeGames contributors). Only the sets that make the
# game run at 60 fps are kept: output, scene, shadow, aspect, mouse_direct and the spin waits need the port's own
# runtime, and pooloff is for texture packs.
# The patch page holds the frame step NXEmu writes at every present: +0 the 30 Hz ratio (seconds * 30), +4 the step
# in seconds, +12 1 while a video plays. The fps60 set lets the game run at 60 fps, and at its own rate while a
# video plays; it is changed from upstream for that.

@nsobid-9B4E43650501A4D4489B4BBFDB740F26AF3CF85
@version 1.2.1

set fps60    TOTK_FPS60          1
set realtime TOTK_REALTIME       1
set cloth    TOTK_CLOTH_REALTIME 1
set bounce   TOTK_HIGHFPS_FIX    1

# 60 fps: the adaptive present-interval controller (main+0x8f26c8) uses the minimum interval 1, except while a video
# plays (patch page +12): the game shows one frame of its 30 fps movies per game frame, so a pre-rendered cutscene plays
# at its speed only at the frame rate the game was made for. The game's minimum at +0 (2: 30 fps) is replaced where it
# is loaded, so the rest of the controller runs as the game wrote it. The flags each cave sets are set again by the
# next compare.
site fps60 main 8f2724 29402e88 @page:x8 b9400d08 7100011f 29402e88 1a9f1508   # ldp w8, w11, [x20]: w8 = video ? minimum : 1
site fps60 main 8f2764 b9401a8a @page:x11 b9400d6b 7100017f b9401a8b 1a8a116a   # ldr w10, [x20, #24]: the stored candidate only while a video plays, else the desired interval (w11 is free)
site fps60 main 8f2858 b9400288 @page:x8 b9400d08 7100011f b9400288 1a9f1508   # ldr w8, [x20]: w8 = video ? minimum : 1
site fps60 main 8f2874 2a0a03f5 1a9fa555   # lower path: csinc w21, w10, wzr, ge (result never below 1)

# Real-time step: the VFR step (main+0x7ede6c, 1.0.0 0x7a83e4) and the global ratio after the controller call
# (main+0x8f2394, 1.0.0 0x8f68b8) read ratio and seconds from the patch page instead of interval * 0.5 and interval / 60.
site realtime main 7ede7c 1e220020 @page:x9   # scvtf s0, w1 -> adrp x9, page
site realtime main 7ede80 52a84e08 bd400120   # mov w8, #60.0 -> ldr s0, [x9] (ratio)
site realtime main 7ede84 1e270101 bd400521   # fmov s1, w8 -> ldr s1, [x9, #4] (seconds)
site realtime main 7ede88 1e2c1002 d503201f   # fmov s2, #0.5 -> nop
site realtime main 7ede94 1e211801 d503201f   # fdiv s1, s0, s1 -> nop
site realtime main 7ede98 1e220800 d503201f   # fmul s0, s0, s2 -> nop
site realtime main 8f2394 bd425e60 @page:x9   # ldr s0, [x19, #0x25c] -> adrp x9, page
site realtime main 8f2398 1e2c1001 bd400120   # fmov s1, #0.5 -> ldr s0, [x9] (global ratio)
site realtime main 8f23a8 5e21d800 d503201f   # scvtf s0, s0 -> nop
site realtime main 8f23ac 1e210800 d503201f   # fmul s0, s0, s1 -> nop

# Equipment-switch cooldown (issue #18, found by JieML1100 on 1.4.3): the player update (main+0x852d24) steps the
# countdown at player state +0x109c through the timer step (main+0xec98cc) only while it is above FLT_EPSILON, but the
# equipment gate (main+0xcae6f8) blocks weapon, shield and bow changes while it is above 0. A measured ratio can leave
# a remainder in (0, FLT_EPSILON] that is never stepped again; stepping while above 0 takes it below 0.
site realtime main 852d28 1e270101 1e2703e1   # fmov s1, w8 (FLT_EPSILON) -> fmov s1, wzr

# Hair and cloth (upstream 290ec9f, 8f8022f): the actor animation update builds a second clock {seconds = factor / 30,
# ratio = factor} per rendered frame. Three inlined places: at the fmul, seconds = measured seconds * factor; at the
# store of the factor into the ratio slot, measured ratio * factor. The call of the shared update (main+0x89822c)
# scales s2 (seconds) and s3 (ratio) by the measured ratio. Upstream's veneer bodies, inlined at the site.
site cloth main 82192c 1e200900 f81f0fe9 @page:x9 bd400520 1e200900 f84107e9   # fmul s0, s8, s0
site cloth main 821928 bd0127e8 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f091f bd0147ff 3dc007ff f94003e9 910083ff   # str s8, [sp, #0x124]
site cloth main 822a64 1e200900 f81f0fe9 @page:x9 bd400520 1e200900 f84107e9   # fmul s0, s8, s0
site cloth main 822a40 bd0127e8 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f091f bd0147ff 3dc007ff f94003e9 910083ff   # str s8, [sp, #0x124]
site cloth main 83182c 1e210801 f81f0fe9 @page:x9 bd400521 1e210801 f84107e9   # fmul s1, s0, s1
site cloth main 831830 bd0137e0 d10083ff f90003e9 3d8007ff @page:x9 bd40013f 1e3f081f bd0157ff 3dc007ff f94003e9 910083ff   # str s0, [sp, #0x134]
site cloth main 8222f0 9401d7cf @page:x8 bd400104 1e240842 1e240863 9401d7cf   # bl 0x89822c

# Trampolines (upstream 27c3b43): the slow-motion check compares time object +0x28 (30 / (ratio * time scale)) with
# 100; compare +0x28 * +0x38 (30 / time scale) instead, the same value at 30 Hz and independent of the frame rate.
site bounce main bda798 bd402900 bd402900 bd403901 1e210800   # ldr s0, [x8, #0x28]; ldr s1, [x8, #0x38]; fmul s0, s0, s1

# Cursor and aim steps (upstream game_patches.c patch_cursor_speed, 363a6eb). These updates read the game's 30 Hz frame
# ratio for their smoothing but leave it out of the step itself, so the map cursor and the vertical Ultrahand aim moved
# 2x as fast at 60 fps and 4x at 120 as at the shipping 30 fps (issue #44). Each site multiplies the step by that ratio,
# so the speed is the shipping one at any frame rate. x9 and s16 are free: the next read of x9 follows a write, the
# function does not touch s16, and x20 keeps the update's frame object for the whole function.
set cursor   TOTK_HIGHFPS_FIX    1
site cursor main ec3d9c bd400361 f94002e9 bd400930 1e300800 bd400361   # map pan speed s0 *= [[x23] + 8], then ldr s1, [x27]
site cursor main 1d48d64 1e2a198c 1e2a198c bd400a90 1e30098c   # fdiv s12, s12, s10, then s12 *= [x20 + 8]: vertical Ultrahand aim
site cursor main 1d484e4 1e200923 1e200923 bd400a90 1e300863   # fmul s3, s9, s0, then s3 *= [x20 + 8]: vertical gyro aim (Recall)
